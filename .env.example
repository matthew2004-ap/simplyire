# PostgreSQL connection string (keep private)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random secret; never commit .env
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Public site URL. Use your Vercel URL in production.
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Paystack TEST secret for local testing; use live key only when ready for real payments.
PAYSTACK_SECRET_KEY="sk_test_replace_me"

# Protects the reservation cleanup cron endpoint.
CRON_SECRET="replace-with-a-second-long-random-secret"

# Optional social links shown in the footer
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""

# Public contact/social information (optional)
NEXT_PUBLIC_CONTACT_EMAIL=""
